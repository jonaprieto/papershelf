<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Note dictation records from the microphone. Under the hardened runtime that
	     notarization requires, audio input is refused without this, and the permission
	     prompt never appears: dictation would simply stop working in a notarized build. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
